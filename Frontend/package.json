{
    "name": "EchoVerse",
    "version": "1.0",
    "private": true,
    "description": "Transforming text into natural sounding speech with advanced AI technology.",
    "scripts": {
        "start": "vite",
        "start:custom": "vite --port 3001",
        "build": "vite build",
        "preview": "vite preview",
        "test": "react-scripts test",
        "tailwindcss": "tailwindcss -i src/css/config.css -o src/css/styles.css --watch --minify"
    },
    "eslintConfig": {
        "extends": [
            "react-app",
            "react-app/jest"
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "keywords": [
        "tts",
        "audio",
        "editor",
        "studio"
    ],
    "homepage": "./public/index.html",
    "bugs": {
        "url": "https://github.com/skye-cyber/EchoVerse/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/skye-cyber/EchoVerse.git"
    },
    "license": "ISC",
    "author": "skye",
    "main": "index.js",
    "dependencies": {
        "aos": "^2.3.4",
        "assert": "^2.1.0",
        "axios": "^1.9.0",
        "bcrypt": "^6.0.0",
        "better-sqlite3": "^11.10.0",
        "browserify": "^17.0.1",
        "browserify-fs": "^1.0.0",
        "buffer": "^6.0.3",
        "cors": "^2.8.5",
        "crypto-browserify": "^3.12.1",
        "emailjs": "^4.0.3",
        "express": "^5.1.0",
        "https-browserify": "^1.0.0",
        "js-cookie": "^3.0.5",
        "os-browserify": "^0.3.0",
        "path-browserify": "^1.0.1",
        "react": "^18.0.0",
        "react-dom": "^18.0.0",
        "react-router-dom": "^7.6.1",
        "react-scripts": "5.0.0",
        "react-swipeable": "^7.0.2",
        "sql.js": "^1.13.0",
        "stream-browserify": "^3.0.0",
        "stream-http": "^3.2.0",
        "util": "^0.12.5",
        "uuid": "^11.1.0",
        "vm-browserify": "^1.1.2"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^5.1.2",
        "autoprefixer": "^10.4.23",
        "copy-webpack-plugin": "^13.0.0",
        "vite": "^7.3.1",
        "vite-plugin-environment": "^1.1.3"
    }
